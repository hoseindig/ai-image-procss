# Copy to `.env` in the project root or `backend/.env`.
# Do not commit `.env`.

APP_NAME=Local Face Camera
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Relative SQLite paths are resolved from the project root.
DATABASE_URL=sqlite:///./data/app.db

LOG_LEVEL=INFO

# Comma-separated origins. Wildcard (*) is not allowed.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# USB webcam (requested values are hints; the driver may ignore them)
CAMERA_DEFAULT_ID=default
CAMERA_DEFAULT_NAME=USB Webcam
CAMERA_DEVICE_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
# Windows: dshow (default) or msmf. Use any for the OpenCV default backend.
CAMERA_BACKEND=dshow

# Face detection (YuNet). Model file must already exist locally.
FACE_DETECTION_ENABLED=true
FACE_DETECTION_MODEL_PATH=models/face/yunet/2023mar.onnx
FACE_DETECTION_CONFIDENCE_THRESHOLD=0.7
FACE_DETECTION_NMS_THRESHOLD=0.3
# 2023mar.onnx is a fixed 640x640 graph under ONNX Runtime.
FACE_DETECTION_INPUT_WIDTH=640
FACE_DETECTION_INPUT_HEIGHT=640
FACE_DETECTION_MAX_FACES=10
FACE_DETECTION_INFERENCE_INTERVAL_MS=100
