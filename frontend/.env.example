# Public frontend configuration only. Never put secrets here.

# Same-origin proxy (recommended for local dev). Next.js rewrites /backend/* to FastAPI.
NEXT_PUBLIC_API_BASE_URL=/backend

# Optional: override the rewrite target (server-side only; not exposed to the browser).
# API_PROXY_TARGET=http://127.0.0.1:8000

# Alternative: call FastAPI directly (requires backend CORS_ORIGINS to include the frontend origin).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
